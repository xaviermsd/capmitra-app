# Get a key at https://elevenlabs.io/app/developers/api-keys (needs Speech to Text permission)
# Only YOU use this key (devices unlocked with your master code, or signed in on /admin).
# Everyone else is asked to add their own key in Settings. See SHARED_KEYS below.
ELEVENLABS_API_KEY=

# Optional: Sarvam AI key for the translated second line (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Optional: team passcode. Set this when you put the app online (e.g. Vercel).
APP_PASSCODE=

# Optional: your live URL, used for social previews and the sitemap (Vercel sets a default)
NEXT_PUBLIC_SITE_URL=
# Optional: set to true only if you want Google to index the site (keep false for a private team tool)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Watermark: exports carry "Made with CapMitra" unless someone redeems a code.
# Make codes at /admin. Use the SAME secret locally and on Vercel, or codes won't match.
ADMIN_PASSWORD=
# Long random string (16+ characters). Changing it cancels every code at once.
WATERMARK_SECRET=
# Optional: switch codes off early. Comma-separated names or full codes, e.g. RAVI,AC-MEERA-...
# (Easier: use Revoke on the /admin page.)
WATERMARK_REVOKED=
# Optional: your personal master code. Typing it in Export → Watermark removes the watermark forever on that device.
WATERMARK_MASTER_CODE=

# Code history on Vercel: connect a free Upstash Redis database (Vercel → Storage).
# Vercel fills these in for you. On your own computer history is saved in .data/ instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or, if you made the database on upstash.com yourself, use Upstash's own names instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Who may use the server's ElevenLabs/Sarvam keys: owner (default) | everyone | off
SHARED_KEYS=owner
